rules_version = '2';

// =============================================================
//  Vive Quintay - Reglas de seguridad Firestore
//  Proyecto: vive-quintay-spa
//
//  ESTE ARCHIVO ES UNA COPIA. Las reglas que rigen son las desplegadas en la
//  consola de Firebase; esta copia existe para versionarlas y revisarlas en el
//  repo. Si se cambian alla, hay que traerlas aca — ya se desincronizaron una vez.
//
//  Modelo:
//   - OPERATIVO (patentes / config): el Verificador exige login.
//   - ATRIBUCION (ingresos): log append-only por operador.
//   - FINANCIERO (cierres / stats / historia del kiosco): solo el admin
//     autenticado, y de SOLO LECTURA. El cliente nunca escribe plata.
//   - La caja (Python) escribe con Admin SDK, que IGNORA estas reglas.
// =============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'admin@vivequintay.cl';
    }

    // OPERATIVO (Verificador — exige login)
    match /activos/{doc} {
      allow read, write: if request.auth != null;
    }
    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ATRIBUCION (Fase 1/2) — log append-only por operador
    match /ingresos/{doc} {
      allow create: if request.auth != null
                    && request.resource.data.operador_uid == request.auth.uid;
      allow read: if request.auth != null
                  && request.auth.token.rol == 'administrador';
      allow update, delete: if false;
    }

    // FINANCIERO (solo admin autenticado)
    match /historico_cierres/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /admin_stats/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /configuracion/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ▼▼▼ NUEVO — HISTORIA DEL KIOSCO ▼▼▼
    // Un documento por MES con el detalle diario adentro. Trae los dos anios y medio
    // que Makito vendio en Eleventa (nov-2023 -> jun-2026) mas lo que la caja sume.
    // Agrupado por mes y no por dia a proposito: 22 lecturas por apertura en vez de 251.
    match /historico_kiosco/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // ▲▲▲ NUEVO ▲▲▲

    // GESTION DE CATALOGO MAKITO (admin, desde el telefono)
    match /makito_catalogo/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /makito_cambios/{doc} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Todo lo demas: cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
